apiVersion: v1
baseDomain: {{ base_domain }}
metadata:
  name: {{ okd_cluster_name }}
compute:
  - name: worker
    replicas: 0
controlPlane:
  name: master
  replicas: 1
networking:
  networkType: OVNKubernetes
  clusterNetwork:
    - cidr: 10.128.0.0/14
      hostPrefix: 23
  serviceNetwork:
    - 172.30.0.0/16
  machineNetwork:
    - cidr: {{ network_cidr }}
platform:
  none: {}
pullSecret: '{{ pull_secret }}'
sshKey: '{{ ssh_pub_key.content | b64decode | trim }}'
