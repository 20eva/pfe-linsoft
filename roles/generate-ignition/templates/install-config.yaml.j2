apiVersion: v1
baseDomain: {{ base_domain }}
metadata:
  name: {{ okd_cluster_name }}
compute:
  - hyperthreading: Enabled
    name: worker
    replicas: 0
controlPlane:
  hyperthreading: Enabled
  name: master
  replicas: 1
networking:
  clusterNetwork:
    - cidr: 10.128.0.0/14
      hostPrefix: 23
  networkType: OVNKubernetes
  serviceNetwork:
    - 172.30.0.0/16
  machineNetwork:
    - cidr: 192.168.100.0/24
platform:
  none: {}
bootstrapInPlace:
  installationDisk: /dev/vda
pullSecret: '{{ pull_secret }}'
sshKey: '{{ ssh_pub_key.content | b64decode | trim }}'
